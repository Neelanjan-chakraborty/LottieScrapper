{
  "manifest_version": 3,
  "name": "Lottie Scraper",
  "short_name": "Lottie Scraper",
  "version": "1.0.0",
  "description": "Detect, preview and bulk-download every Lottie animation on a page as JSON, .lottie or a single ZIP.",
  "author": "Neelanjan Chakraborty",
  "homepage_url": "https://github.com/Neelanjan-chakraborty/LottieScrapper",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lottie Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
